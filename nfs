#!/usr/bin/env rakudo

use lib 'lib';
use util;

sub MAIN($op = "mount", $conf = "./nfs.conf")
{
    if ($conf.IO !~~ :e) {
	say "$conf do not exist,please check it";
	exit(0);
    }
    say "\nusing conf: $conf\n";
    my $fh = $conf.IO.open :ro;

    for $fh.lines -> $l {
	next if $l.starts-with('#');
	next if $l.trim eq ('');
	say $l;
	my ($host,$ip,$devs) = $l.split(':');
	if ($op ~~ "mount") {
	   say "mounting $host@$ip:$devs";
	   qqx/sudo rakudo pt $devs mount nfs $ip $host/;
	}
	if ($op ~~ "umount") {
	   say "umounting /$host/*";
           my $path = "/" ~ $host ~ "/*";
           qqx/sudo umount -f $path/;
	}
    }

    if ($op ~~ "stop") {
        say "stoping nfs-kernel-server";
	qqx/service nfs-server stop/;
    }
    if ($op ~~ "restart") {
	say "stoping nfs-kernel-server";
	qqx/\/etc\/init\.d\/nfs-kernel-server restart/;
    }

    close $fh;
}
