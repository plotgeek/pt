#!/usr/bin/env rakudo

use lib 'lib';
use lib '.';
use plot;
use util;
use Conf;

sub MAIN($dirs, $gpu = "all", $varg = "varg") 
{
    my $conf  = Conf.new;
    my @disks = parse_comma($dirs);
    my $path = "";    
    my $addr  = $conf.addr;
    my $level = $conf.nossd_level;
    say $level, $addr;
    my $num   = (^10000).pick;
    my $spath = '~/.nossd/' ~ $num;
    my $sname = "";
    my $nossd = $conf.nossd; 
    my $stop  = $conf.stop;
    my $log   = $*HOME ~ "/log";

    my @pf  = parse_comma($conf.mount_prefix);
    for @pf -> $prefix {
	if ($prefix ~~ '/') {
	    $sname = 'localhost' ~ '_';
	} else {
    	    $sname = $sname ~ $prefix ~ '_';
	}
        for @disks -> $d {
	    #say "dir: $d" ;
	    my $f_dir="";
	    if ($prefix ~~ '/') {
	        $f_dir = '/sd' ~ $d ~ '/' ~ 'plots/';
	    } else {
	        $f_dir = '/' ~ $prefix ~ '/sd' ~ $d ~ '/' ~ 'plots/';
	    }

	    if ($f_dir.IO ~~ :e ) {
	       #$sname = $sname ~ $d;
               if ($conf.nossd_mining) {
	          $path = $path ~ '-d,r ' ~ $f_dir ~ " ";
	       } else {
	          $path = $path ~ '-d,~t ' ~ $f_dir ~ " ";
	       }
	     }
         }
    }
    $sname = $sname ~ $dirs;
    my $gpu_str = "";
    if ($gpu ~~ 'all') {
       my $g_str = get_all_gpu_uuid();
       my @gpus = parse_comma($g_str);
       if ($conf.nossd_mining) {
	   for @gpus -> $g {
	        $gpu_str = $gpu_str ~ "  -g " ~ $g;     
	   }
       } else {
           $gpu_str = " -x " ~ @gpus[0];
       }
    } elsif ($gpu ~~ '0') {
       my $g = get_first_gpu_uuid();
       if ($conf.nossd_mining) {
           $gpu_str = "  -g " ~ $g;
       } else {
           $gpu_str = " -x " ~ $g;
       }
    } else {
       my @gpus = parse_comma($gpu);
       if ($conf.nossd_mining) {
          for @gpus -> $g {
             say $g;
	     $gpu_str =  $gpu_str ~ " -g " ~ $g
          }
          say $gpu_str;
       } else {
          $gpu_str = " -x " ~ $gpu;
       }
    }

    if ($conf.nossd_mining) {
       say "mining mode";
       say $gpu_str;
       my $hostname = $*KERNEL.hostname;
       $sname = "mining_" ~ $sname;
       say "qqx/tmux new -s $sname -d $nossd $path -a $addr -s $spath $gpu_str -w $hostname/";
       qqx/tmux new -s $sname -d $nossd $path -a $addr -s $spath $gpu_str -w $hostname/;
       if ($conf.tmux_log) {
          say "loging for mining sesions $sname";
	  if ($log.IO.e) {
	      say "log dir $log";
	  } else {
	      say "createing $log";
	      $log.IO.mkdir;
	  }
          qqx/tmux pipe-pane -t $sname "cat >> ~\/log\/mining.log"/;
       }
    } else {
       say "ploting mode";
       if ($conf.notmp) {
       	    $path = $path ~ ' --no-temp ';            
       } else {
       	    $path = $path ~ '-d,t ' ~ $varg;
       }
       say $path;
       my $sname = 'plot_' ~ $dirs ~ '_' ~ $num;
       my $pth_num = $conf.p_threads;
       if ($conf.use_cpu) {
       	  say "qqx/tmux new -s $sname -d $nossd $path -c $level -a $addr -s $spath --p-threads $pth_num --no-gpu-mining/";
       	  qqx/tmux new -s $sname -d $nossd $path -c $level -a $addr -s $spath --p-threads $pth_num --no-gpu-mining/;
	  if ($conf.tmux_log) {
	     say "loging for cpu plot session $sname";
	     if ($log.IO.e) {
	         say "log dir $log";
	     } else {
	         say "createing $log";
	        $log.IO.mkdir;
	     }
	     qqx/tmux pipe-pane -t $sname "cat >> ~\/log\/plot_cpu.log"/;
	  }
       } else {
          say "qqx/tmux new -s $sname -d $nossd $path -c $level -a $addr -s $spath $gpu_str --no-gpu-mining $stop/";
          qqx/tmux new -s $sname -d $nossd $path -c $level -a $addr -s $spath  $gpu_str --no-gpu-mining $stop/;
	  if ($conf.tmux_log) {
	     say "loging for gpu plot session $sname";
	     if ($log.IO.e) {
	        say "log dir $log";
	     } else {
	        say "createing $log";
	        $log.IO.mkdir;
	     }
	     qqx/tmux pipe-pane -t $sname "cat >> ~\/log\/plot_gpu.log"/;
	  }
       }
    }
}
