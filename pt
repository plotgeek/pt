multi sub MAIN($dirs, "umount")
{
    my @disks = parse_comma($dirs);

    my @promises;
    for @disks -> $d {
        @promises.push: start {
            umount($d);
	}
    }
    await @promises;
    say "\nparalle umount done\n";
}

multi sub MAIN($dirs, "format", $type = "xfs")
{
    my @disks = parse_comma($dirs);
    for @disks -> $d {
	format($d, $type);
    }
}

multi sub MAIN($dirs, "nfs", $rwo = "ro")
{
    my @disks = parse_comma($dirs);
    my $nfs_conf = "/etc/exports";
    for @disks -> $d {
       my $ed = "/sd" ~ $d ~ " *($rwo,async,no_subtree_check,no_root_squash)\n";
       spurt $nfs_conf, $ed, :append;
    }
    say "restarting nfs-server";
    qqx/service  nfs-server restart/;
}

multi sub MAIN($dirs, "copy")
{
    my @disks = parse_comma($dirs);
    for @disks -> $d {
        my $sname =  'copy_' ~ $d;
        qqx/rakudo copy.raku $d/;
    }
}

multi sub MAIN($dirs, "write", $src_dir = "nv0")
{
    my @disks = parse_comma($dirs);
    qqx/rakudo write.raku $dirs $src_dir/;
}

multi sub MAIN($dirs, "log", $cnt = 10)
{
    my @disks = parse_comma($dirs);
    my $xchlog = "~/log/mining.log";
    for @disks -> $h {
        say "========$h start============";
        say qqx/ssh pt@$h tail -n $cnt $xchlog/;
    }
}

multi sub MAIN($dirs, "stat", $cmd = "df -h")
{
    my @disks = parse_comma($dirs);
    for @disks -> $h {
	say "========$h start============";
	say qqx/ssh pt@$h $cmd/;
    }
}

multi sub MAIN($dirs, "scp", $src = "./pt")
{
    my @disks = parse_comma($dirs);
    for @disks -> $h {
        say "========$h start============";
        qqx/scp -r $src $h@$h:~\//;
    }
}


multi sub MAIN($dirs, "auth") 
{
    my @disks;
    @disks = parse_comma($dirs);
    for @disks -> $d {
        my $hdir   =   "/sd" ~ $d ~ "/"; 
        say "chmoding: $hdir";
        qqx/sudo chmod a+rwx -R $hdir/;
    }
}

multi sub MAIN($dirs, "snum") 
{
    my @disks;
    @disks = parse_comma($dirs);
    my $snum = "";
    for @disks -> $d {
        my $dev =  "/dev/sd" ~ $d;
	$snum    =  get_hdd_serial($dev);
	say "$dev: $snum";
    }
}

multi sub MAIN($dirs, "temp") 
{
    my @disks = parse_comma($dirs);
    for @disks -> $d {
        my $dev    =  "/dev/sd" ~ $d;
        my $temp     =  get_hdd_temp($dev);
	say "$dev : $temp";
    }
}
