#!/usr/bin/env rakudo


use lib 'lib';
use lib '.';
use plot;
use util;
use Conf;

proto sub MAIN(|) is export { * }



multi sub MAIN($dirs, "clean")
{
    my @disks;
    @disks = parse_comma($dirs);
    clean(@disks);
}

multi sub MAIN($dirs, "count", $type = "fpt")
{
    my @disks;
    @disks = parse_comma($dirs);
    my $cnt = 0;
    my $ft = $type;

    if ($ft ~~ 'plot') {
	$cnt = count(@disks, 'plot');
	say @disks.elems  ~ " disks, total $ft: $cnt ";
    }
    if ($ft ~~ 'spt') {
	$cnt = count(@disks, 'spt');      
	say @disks.elems  ~ " disks, total $ft: $cnt ";
    }
    if ($ft ~~ 'fpt') {
	$cnt = count(@disks, 'fpt');
	say @disks.elems  ~ " disks, total $ft: $cnt ";
    }
    if ($ft ~~ 'disk') {
	say "$dirs is total " ~ @disks.elems ~ " disks\n";
    }
}

multi sub MAIN($dirs, "rmsys")
{
    my @disks;
    @disks = parse_comma($dirs);
    rmsys(@disks);
}

multi sub MAIN($dirs, "rm", $cnt = 2)
{
    my @disks;
    @disks = parse_comma($dirs);
    rm(@disks, $cnt);
}

multi sub MAIN($dirs, "test", $write_or_clean = "write")
{
    my @disks;
    my $op = $write_or_clean;
    @disks = parse_comma($dirs);
    test(@disks, $op);
}

multi sub MAIN($dirs, "mount", $type= "xfs", $rwo = "rw")
{
    my @disks = parse_comma($dirs);
    my $conf  = Conf.new;
    
    my @promises;
    for @disks -> $d {
	say $d;
        @promises.push: start {
           mount($d, $type, $rwo);
	}
    }
    await @promises;
    say "\nparalle mount done\n";

    if ($conf.nossd_mining) {
       say "resart nfs server";
       qqx/\/etc\/init\.d\/nfs-kernel-server restart/;
    }
}

